<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toolkit Client Setup" Height="680" Width="980" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E" Foreground="#FFCDD6F4" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FF2D2D44"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#FF3D3D5C"/>
        <SolidColorBrush x:Key="Accent" Color="#FF89B4FA"/>
        <SolidColorBrush x:Key="Dim" Color="#FFA6ADC8"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3D3D5C"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="BorderBrush" Value="#FF4D4D6C"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF181825"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="BorderBrush" Value="#FF4D4D6C"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#FFCDD6F4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF181825"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="BorderBrush" Value="#FF4D4D6C"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFCDD6F4"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#FFCDD6F4"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF89B4FA"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFA6ADC8"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Steps -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="Client Setup" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="4,4,0,2"/>
                <TextBlock DockPanel.Dock="Top" Name="txtCoreInfo" Text="" Foreground="{StaticResource Dim}" Margin="4,0,0,16" TextWrapping="Wrap"/>
                <ListBox Name="lstSteps" Background="Transparent" BorderThickness="0" Foreground="#FFCDD6F4" FontSize="14">
                    <ListBoxItem Padding="8,7">1. Welcome</ListBoxItem>
                    <ListBoxItem Padding="8,7">2. Brand</ListBoxItem>
                    <ListBoxItem Padding="8,7">3. Modules</ListBoxItem>
                    <ListBoxItem Padding="8,7">4. Secrets</ListBoxItem>
                    <ListBoxItem Padding="8,7">5. Installers</ListBoxItem>
                    <ListBoxItem Padding="8,7">6. Updates</ListBoxItem>
                    <ListBoxItem Padding="8,7">7. Check &amp; Build</ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="28,22,28,10">

            <!-- 1 Welcome -->
            <ScrollViewer Name="page0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Set up your branded toolkit"/>
                    <TextBlock Style="{StaticResource Hint}" Name="txtWelcome"
                               Text="This wizard creates and edits your client folder: your name, colors, logo, modules and installers. It never changes the core toolkit, so core updates can always be applied safely."/>
                    <Border Name="bdrIntegrity" CornerRadius="4" Padding="12" Margin="0,0,0,16" Background="#FF2D2D44">
                        <StackPanel>
                            <TextBlock Name="txtIntegrityTitle" FontWeight="Bold" Text="Checking core files..."/>
                            <TextBlock Name="txtIntegrityDetail" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Label}" Text="Moving to a new core version, or restoring a backup?"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Import a client package (.zip) that you exported earlier from this wizard. Your current client folder is backed up first."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="btnImport" Content="Import client package..."/>
                        <Button Name="btnOpenGuide" Content="Open the client guide"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 2 Brand -->
            <ScrollViewer Name="page1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Brand"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Shown in the window title, header, session report and installer dialogs."/>
                    <Border CornerRadius="4" Background="#FF181825" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Height="50" Margin="0,0,0,10">
                        <DockPanel Margin="16,0">
                            <Image Name="imgPreviewLogo" Height="28" MaxWidth="160" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center" DockPanel.Dock="Left" Visibility="Collapsed"/>
                            <TextBlock Name="txtPreviewName" Text="Technician Toolkit" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left" Foreground="{StaticResource Accent}"/>
                            <TextBlock Name="txtPreviewVersion" Text="v1.0.0" FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Live preview" Foreground="{StaticResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Label}" Text="Product name"/>
                    <TextBox Name="txtProductName" MaxLength="60"/>
                    <TextBlock Style="{StaticResource Label}" Text="Accent color"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="txtAccent" Width="110" MaxLength="7"/>
                        <WrapPanel Name="pnlSwatches" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Logo (PNG, up to 256 KB, shown about 28 px tall)"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="btnLogo" Content="Choose logo..."/>
                        <Button Name="btnLogoRemove" Content="Remove logo"/>
                        <TextBlock Name="txtLogoInfo" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Support contact (shown in the log and session report)"/>
                    <TextBox Name="txtSupport" MaxLength="120"/>
                    <TextBlock Style="{StaticResource Label}" Text="Company name (shown in the exe's file properties; empty = product name)"/>
                    <TextBox Name="txtCompany" MaxLength="100"/>
                    <TextBlock Style="{StaticResource Label}" Text="Your version"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="txtVersion" Width="110"/>
                        <TextBlock Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                                   Text="Raised automatically when you build again with the same version."/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 3 Modules -->
            <DockPanel Name="page2" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource H1}" Text="Modules"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Untick Show to hide a module from the menu. Tick Lock to require the toolkit password for it (locked exe and USB builds). Core modules can be hidden but not removed; your own modules can be added and removed."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="btnAddModule" Content="Add module file..."/>
                        <Button Name="btnLockAll" Content="Lock all"/>
                        <Button Name="btnUnlockAll" Content="Unlock all"/>
                        <Button Name="btnModuleGuide" Content="Export guide for AI agent..."
                                ToolTip="Save a .md file that explains to an AI coding agent how modules work and how to write one for this toolkit"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Name="txtNewModule" Width="240"/>
                        <Button Name="btnNewModule" Content="Create new module from template" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Module" Foreground="{StaticResource Dim}"/>
                        <TextBlock Grid.Column="1" Text="Source" Foreground="{StaticResource Dim}"/>
                        <TextBlock Grid.Column="2" Text="Show" Foreground="{StaticResource Dim}"/>
                        <TextBlock Grid.Column="3" Text="Lock" Foreground="{StaticResource Dim}"/>
                    </Grid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="pnlModules"/>
                </ScrollViewer>
            </DockPanel>

            <!-- 4 Secrets -->
            <DockPanel Name="page3" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource H1}" Text="Secrets"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Values your modules need that nobody should be able to read or copy: RMM site keys, tenant tokens, API keys, passwords. A module reads one with Get-ToolkitSecret 'Name' (lock that module on the Modules page)."/>
                    <TextBlock Style="{StaticResource Hint}" Text="On this PC the values are encrypted for your Windows account only. They go into locked exe and USB builds, encrypted under the kit password. They are never in the plain exe, in git, or in a client package unless you choose to include them when exporting."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Name="txtSecretName" Width="240" ToolTip="Letters, digits and _ (for example RmmSiteKey)"/>
                        <Button Name="btnAddSecret" Content="Add secret" Margin="8,0,0,0"/>
                        <Button Name="btnImportSecrets" Content="Import secrets from module..." Margin="8,0,0,0" ToolTip="Pick a module file: every secret it lists (Secrets = @(...)) or reads (Get-ToolkitSecret) is added here, ready for its value."/>
                        <TextBlock Name="txtSecretInfo" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Foreground="{StaticResource Dim}"/>
                        <TextBlock Grid.Column="1" Text="Value" Foreground="{StaticResource Dim}"/>
                    </Grid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="pnlSecrets"/>
                </ScrollViewer>
            </DockPanel>

            <!-- 5 Installers -->
            <DockPanel Name="page4" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource H1}" Text="Installers"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Your .exe and .msi installers (for example your RMM agent). They appear in Software Manager under Custom Installers. Everything here ships in every exe, USB and ConnectWise upload, so keep it small."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Name="btnAddInstaller" Content="Add installers..."/>
                        <TextBlock Name="txtInstallerTotal" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="pnlInstallers"/>
                </ScrollViewer>
            </DockPanel>

            <!-- 6 Updates -->
            <ScrollViewer Name="page5" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Updates"/>
                    <TextBlock Style="{StaticResource Hint}" Text="How USB toolkits update themselves when they start (the technician is always asked first)."/>
                    <RadioButton Name="rbCore" GroupName="upd" Content="Automatic core updates (recommended)"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="22,-4,0,12" Text="USB toolkits download new core versions from the toolkit provider and keep your client folder (branding, modules, installers) as it is. No GitHub needed."/>
                    <RadioButton Name="rbCustom" GroupName="upd" Content="My own update feed (advanced)"/>
                    <StackPanel Name="pnlCustom" Margin="22,0,0,12">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="An https folder that serves version.txt, latest.zip and latest.sha256 - for example your own GitHub repo's Releases (public), Azure Blob or S3. Your releases must include your client folder."/>
                        <TextBox Name="txtFeedUrl"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="GitHub owner/repo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Name="txtGitHubRepo" Width="220"/>
                            <Button Name="btnFillGitHub" Content="Fill in URL" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <RadioButton Name="rbNone" GroupName="upd" Content="No automatic updates"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="22,-4,0,12" Text="Rebuild your exe/USB yourself when you want a newer version."/>
                </StackPanel>
            </ScrollViewer>

            <!-- 7 Build -->
            <DockPanel Name="page6" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource H1}" Text="Check &amp; Build"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Everything is checked before each build. Builds go to the output folder below (default: the toolkit's _builds folder). 'Build exe + folder' also makes a ready-to-run copy you start with its Launch.bat. The exe names stay EndpointToolkit.exe and EndpointToolkit_Locked.exe, so existing ConnectWise Toolbox entries keep working."/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Name="btnCheck" Content="Check everything" Margin="0,0,8,8"/>
                        <Button Name="btnBuildExe" Content="Build exe + folder" Margin="0,0,8,8"/>
                        <Button Name="btnMakeUsb" Content="Make USB..." Margin="0,0,8,8"/>
                        <Button Name="btnExport" Content="Export client package..." Margin="0,0,8,8"/>
                        <CheckBox Name="chkExportSecrets" Content="Include secret values (asks for a passphrase)" VerticalAlignment="Center" Margin="0,0,16,8"/>
                        <Button Name="btnOpenBuilds" Content="Open builds folder" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Output folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Name="btnOutputDefault" Content="Default" Margin="8,0,0,0" ToolTip="Use the toolkit's _builds folder"/>
                        <Button DockPanel.Dock="Right" Name="btnOutputBrowse" Content="Browse..." Margin="8,0,0,0"/>
                        <TextBox Name="txtOutputDir" VerticalContentAlignment="Center" ToolTip="Where 'Build exe + folder' and 'Build locked exe' put their output. Must be outside the toolkit folder (or its _builds folder). Remembered on this PC."/>
                    </DockPanel>
                    <Border CornerRadius="4" Background="#FF2D2D44" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Locked exe password:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <PasswordBox Name="pwd1" Width="150"/>
                            <TextBlock Text="Confirm:" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <PasswordBox Name="pwd2" Width="150"/>
                            <Button Name="btnBuildLocked" Content="Build locked exe" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBox Name="txtOutput" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
            </DockPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Column="1" Grid.Row="1" Background="#FF181825" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="28,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="btnBack" Content="Back"/>
                    <Button Name="btnNext" Content="Next"/>
                    <Button Name="btnSave" Content="Save" Margin="0"/>
                </StackPanel>
                <TextBlock Name="txtStatus" VerticalAlignment="Center" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
